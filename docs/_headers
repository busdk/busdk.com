# Optional headers for static hosts that support Netlify/Cloudflare Pages-style
# _headers files. GitHub Pages ignores this file, so the deployed
# busdk.com/engine/ page still needs an actual header-capable host or proxy
# before the live Bus Engine OS iframe can activate.

/engine/
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/engine/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
